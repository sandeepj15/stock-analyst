# Copy this file to .env and fill in values for local development.
# Never commit the real .env file (it is gitignored).

# --- Core infra ---
DATABASE_URL=postgresql+asyncpg://signalforge:signalforge@postgres:5432/signalforge
REDIS_URL=redis://redis:6379/0

# --- Market data provider (SPEC.md section 8) ---
# yfinance_dev is the only implemented provider in this phase: free, no
# API key, local-dev only, NOT licensed for commercial redistribution.
# See DATA_SOURCES.md.
MARKET_DATA_PROVIDER=yfinance_dev
MARKET_DATA_API_KEY=

# --- Fundamentals provider (SPEC.md section 85) ---
# Empty/"yfinance_dev" = yfinance only. "yfinance_tradingview_fallback" or
# "yfinance_screener_fallback" fill yfinance's gaps from a second source -
# see packages/fundamentals/factory.py and DATA_SOURCES.md.
FUNDAMENTAL_PROVIDER=
FUNDAMENTAL_API_KEY=

# --- Fundamentals & Screener.in Sync ---
# Optional: session cookies from screener.in to unlock higher rate limits and full 14-quarter history.
# Inspect browser DevTools Application -> Cookies for www.screener.in to find these.
SCREENER_SESSION_ID=
SCREENER_CSRF_TOKEN=

# --- News provider (not used until a later phase) ---
NEWS_PROVIDER=
NEWS_API_KEY=

# --- LLM / AI explanation layer ---
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_API_KEY=

# --- Security ---
# generate with: openssl rand -hex 32
JWT_SECRET=
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Object storage (not used in this phase) ---
S3_BUCKET=
AWS_REGION=

# --- API process config ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Optional free-tier keys for future redundancy (SPEC.md section 105.2) ---
# Not required for local dev. Would back alternative/backup market-data
# or news providers in a later phase.
# ALPHA_VANTAGE_API_KEY=
# TWELVEDATA_API_KEY=
# NEWSAPI_API_KEY=

# --- AI layer, required starting Phase 10 (SPEC.md section 105.2) ---
# ANTHROPIC_API_KEY=
